# Retriever API configuration. Copy to .env and fill in.

# --- Required ---
OPENAI_API_KEY=sk-...

# Qdrant. Local Docker default is http://localhost:6333 (see docker/docker-compose.yml).
# For Qdrant Cloud, use the cluster URL and set QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Security ---
# Comma-separated browser origins allowed to call this API.
# Defaults to http://localhost:3000 when unset. Set this to your deployed
# frontend URL in production, or anyone can spend your API credits.
ALLOWED_ORIGINS=http://localhost:3000

# Set to "production" when deployed. Disables /debug/* and stops raw
# exception text from being returned to clients.
NODE_ENV=development

# --- Optional ---
PORT=8000
COLLECTION=labor_assistant_v1

# Text-to-speech (ElevenLabs). Voice answers are disabled if unset.
ELEVENLABS_API_KEY=
TTS_VOICE_ZH=
TTS_VOICE_EN=
TTS_MODEL=eleven_multilingual_v2
