# Retriever API configuration. Copy to .env and fill in.

# --- Required ---
OPENAI_API_KEY=sk-...

# Qdrant. Local Docker default is http://localhost:6333 (see docker/docker-compose.yml).
# For Qdrant Cloud, use the cluster URL and set QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Security ---
# Comma-separated browser origins allowed to call this API.
# Defaults to http://localhost:3000 when unset. Set this to your deployed
# frontend URL in production, or anyone can spend your API credits.
ALLOWED_ORIGINS=http://localhost:3000

# Set to "production" when deployed. Disables /debug/* and stops raw
# exception text from being returned to clients.
NODE_ENV=development

# Per-IP request caps, per minute. The defaults below are what a deployed
# instance should run with. Raise RATE_LIMIT_ASK when running the 50-question
# evaluation batch locally (run_batch.py backs off on 429 either way).
RATE_LIMIT_ASK=10
RATE_LIMIT_TTS=10
RATE_LIMIT_TRANSCRIBE=5
RATE_LIMIT_GLOBAL=60

# --- Models ---
# gpt-4o is what the thesis evaluation was run against, so it is the default.
# A public demo can set gpt-4o-mini to cut per-query cost roughly 17x.
CHAT_MODEL=gpt-4o
CHAT_TEMPERATURE=0.2
# Changing this requires re-ingesting: the collection stores 3072-dim vectors.
EMBED_MODEL=text-embedding-3-large

# --- Optional ---
PORT=8000
COLLECTION=labor_assistant_v1

# Text-to-speech (ElevenLabs). Voice answers are disabled if unset.
ELEVENLABS_API_KEY=
TTS_VOICE_ZH=
TTS_VOICE_EN=
TTS_MODEL=eleven_multilingual_v2
